<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="Modern batch image converter - Convert, resize, and watermark images with ease">
<title><%= title %> - Professional Image Processing</title>

<!-- Preload critical resources -->
<link rel="preload" href="/css/main.css" as="style">
<link rel="preload" href="/js/app.js" as="script">

<!-- Stylesheets -->
<link rel="stylesheet" href="/css/main.css">
<link rel="stylesheet" href="/css/components.css">
<link rel="stylesheet" href="/css/mobile.css">

<!-- Favicon and PWA -->
<link rel="icon" type="image/svg+xml" href="/icons/favicon.svg">
<meta name="theme-color" content="#0ea5e9">

<!-- Open Graph -->
<meta property="og:title" content="<%= title %> - Image Converter">
<meta property="og:description" content="Professional batch image processing tool">
<meta property="og:type" content="website">



<style>
    /* Upload Limits Styling - MISSING */
.upload-limits {
    display: flex;
    justify-content: center;
    gap: var(--spacing-xl);
    margin-top: var(--spacing-xl);
    padding: var(--spacing-lg);
    background: var(--bg-glass);
    backdrop-filter: blur(10px);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
}

.limit-item {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    font-size: var(--font-size-sm);
    color: var(--text-muted);
    font-weight: 500;
}

.limit-icon {
    width: 20px;
    height: 20px;
    color: var(--accent-primary);
    flex-shrink: 0;
}

.limit-item span {
    white-space: nowrap;
}

/* Responsive upload limits */
@media (max-width: 768px) {
    .upload-limits {
        flex-direction: column;
        gap: var(--spacing-md);
        text-align: center;
    }
    
    .limit-item {
        justify-content: center;
    }
}


/* Download Center Stats - Fix oversized display */
.download-center {
    max-width: 600px;
    margin: 0 auto;
    text-align: center;
}

.download-summary h3 {
    font-size: var(--font-size-2xl);
    margin-bottom: var(--spacing-md);
}

.download-summary p {
    font-size: var(--font-size-lg);
    margin-bottom: var(--spacing-xl);
}

.compression-stats {
    margin-top: var(--spacing-xl);
    padding: var(--spacing-lg);
}

.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: var(--spacing-lg);
    max-width: 400px;
    margin: 0 auto;
}

.stat-item {
    text-align: center;
}

.stat-label {
    display: block;
    font-size: var(--font-size-xs);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: var(--spacing-xs);
}

.stat-value {
    display: block;
    font-size: var(--font-size-xl);
    font-weight: 700;
    color: var(--text-primary);
}

/* Upload Zone Content - Fix sizing */
.upload-content {
    position: relative;
    z-index: 2;
    max-width: 500px;
    margin: 0 auto;
}

.upload-icon {
    width: 64px;
    height: 64px;
    color: var(--accent-primary);
    filter: drop-shadow(0 0 20px var(--accent-glow));
    transition: var(--transition);
    margin: 0 auto;
    display: block;
}

.upload-title {
    font-size: var(--font-size-2xl);
    font-weight: 700;
    margin: var(--spacing-lg) 0 var(--spacing-md) 0;
    text-align: center;
}

.upload-subtitle {
    font-size: var(--font-size-base);
    color: var(--text-muted);
    margin-bottom: var(--spacing-xl);
    line-height: 1.6;
    text-align: center;
}

/* Format tags sizing */
.supported-formats {
    display: flex;
    justify-content: center;
    gap: var(--spacing-sm);
    margin-top: var(--spacing-md);
    flex-wrap: wrap;
}

.format-tag {
    background: var(--bg-glass);
    backdrop-filter: blur(10px);
    color: var(--accent-primary);
    padding: var(--spacing-xs) var(--spacing-sm);
    border-radius: 16px;
    font-size: var(--font-size-xs);
    font-weight: 500;
    border: 1px solid var(--border);
    transition: var(--transition);
}

/* Processing Dashboard - Fix oversized elements */
.processing-dashboard {
    max-width: 600px;
    margin: 0 auto var(--spacing-2xl) auto;
    padding: var(--spacing-xl);
}

.progress-overview {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-xl);
    max-width: 500px;
    margin: 0 auto;
}

.progress-ring {
    position: relative;
    display: inline-block;
    flex-shrink: 0;
}

.progress-circle {
    width: 120px;
    height: 120px;
    transform: rotate(-90deg);
    filter: drop-shadow(0 0 20px var(--accent-glow));
}

.progress-text {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
}

#progress-percentage {
    display: block;
    font-size: var(--font-size-2xl);
    font-weight: 800;
    line-height: 1;
    margin-bottom: var(--spacing-xs);
}

.progress-label {
    font-size: var(--font-size-sm);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.progress-details {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    min-width: 200px;
}

.stat {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--spacing-sm) 0;
    border-bottom: 1px solid var(--border);
}

.stat:last-child {
    border-bottom: none;
}

.stat-label {
    font-size: var(--font-size-sm);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.stat span:last-child {
    font-size: var(--font-size-base);
    font-weight: 600;
    color: var(--text-primary);
}

/* Mobile fixes for oversized elements */
@media (max-width: 768px) {
    .upload-limits {
        padding: var(--spacing-md);
        gap: var(--spacing-md);
    }
    
    .limit-item {
        font-size: var(--font-size-xs);
    }
    
    .limit-icon {
        width: 16px;
        height: 16px;
    }
    
    .progress-overview {
        flex-direction: column;
        gap: var(--spacing-lg);
    }
    
    .progress-details {
        width: 100%;
        max-width: 300px;
    }
    
    .download-center {
        padding: var(--spacing-lg);
    }
    
    .stats-grid {
        grid-template-columns: 1fr;
        gap: var(--spacing-md);
    }
}

/* Toast Notifications - MISSING CRITICAL CSS */
.toast-container {
    position: fixed;
    top: var(--spacing-xl);
    right: var(--spacing-xl);
    z-index: 1000;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    pointer-events: none;
    max-width: 400px;
}

.toast {
    background: var(--bg-glass);
    backdrop-filter: blur(30px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--spacing-lg);
    box-shadow: var(--shadow-xl);
    min-width: 320px;
    max-width: 400px;
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-md);
    transform: translateX(100%);
    animation: slideInToast 0.5s var(--bounce) forwards;
    position: relative;
    overflow: hidden;
    pointer-events: all;
    cursor: pointer;
}

.toast::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--accent-gradient);
    opacity: 0.03;
    pointer-events: none;
}

/* Toast Animation */
@keyframes slideInToast {
    from {
        transform: translateX(100%);
        opacity: 0;
    }
    to {
        transform: translateX(0);
        opacity: 1;
    }
}

/* Toast Slide Out Animation */
@keyframes slideOutToast {
    from {
        transform: translateX(0);
        opacity: 1;
    }
    to {
        transform: translateX(100%);
        opacity: 0;
    }
}

/* Toast Types */
.toast.success {
    border-left: 4px solid var(--success);
    box-shadow: var(--shadow-xl), 0 0 20px var(--success-glow);
}

.toast.success .toast-icon {
    color: var(--success);
}

.toast.error {
    border-left: 4px solid var(--error);
    box-shadow: var(--shadow-xl), 0 0 20px var(--error-glow);
}

.toast.error .toast-icon {
    color: var(--error);
}

.toast.warning {
    border-left: 4px solid var(--warning);
    box-shadow: var(--shadow-xl), 0 0 20px var(--warning-glow);
}

.toast.warning .toast-icon {
    color: var(--warning);
}

.toast.info {
    border-left: 4px solid var(--accent-primary);
    box-shadow: var(--shadow-xl), 0 0 20px var(--accent-glow);
}

.toast.info .toast-icon {
    color: var(--accent-primary);
}

/* Toast Icon */
.toast-icon {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    stroke-width: 2;
    margin-top: 2px;
}

/* Toast Content */
.toast-content {
    flex: 1;
    min-width: 0;
}

.toast-message {
    font-size: var(--font-size-sm);
    font-weight: 500;
    color: var(--text-primary);
    line-height: 1.5;
    word-wrap: break-word;
}

/* Toast Close Button */
.toast-close {
    background: none;
    border: none;
    color: var(--text-muted);
    font-size: 18px;
    font-weight: 700;
    cursor: pointer;
    padding: 0;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: var(--transition);
    flex-shrink: 0;
    line-height: 1;
}

.toast-close:hover {
    background: var(--bg-tertiary);
    color: var(--text-primary);
    transform: scale(1.1);
}

/* Toast Progress Bar (optional) */
.toast-progress {
    position: absolute;
    bottom: 0;
    left: 0;
    height: 3px;
    background: currentColor;
    border-radius: 0 0 var(--radius-lg) var(--radius-lg);
    transform-origin: left;
    animation: toastProgress 4s linear forwards;
    opacity: 0.6;
}

@keyframes toastProgress {
    from {
        transform: scaleX(1);
    }
    to {
        transform: scaleX(0);
    }
}

/* Mobile Toast Styles */
@media (max-width: 768px) {
    .toast-container {
        top: var(--spacing-lg);
        right: var(--spacing-lg);
        left: var(--spacing-lg);
        max-width: none;
    }
    
    .toast {
        min-width: auto;
        max-width: none;
        width: 100%;
        padding: var(--spacing-md);
    }
    
    .toast-message {
        font-size: var(--font-size-xs);
    }
    
    .toast-icon {
        width: 20px;
        height: 20px;
    }
    
    .toast-close {
        width: 20px;
        height: 20px;
        font-size: 16px;
    }
}

/* Toast Stacking */
.toast:nth-child(1) { z-index: 1000; }
.toast:nth-child(2) { z-index: 999; margin-top: 4px; }
.toast:nth-child(3) { z-index: 998; margin-top: 8px; }
.toast:nth-child(4) { z-index: 997; margin-top: 12px; }

/* Multiple toast spacing */
.toast + .toast {
    margin-top: var(--spacing-md);
}

/* Toast hover effects */
.toast:hover {
    transform: translateX(-4px);
    box-shadow: var(--shadow-xl), 0 0 30px rgba(59, 130, 246, 0.2);
}

/* Accessibility improvements */
.toast:focus-visible {
    outline: 2px solid var(--accent-primary);
    outline-offset: 2px;
}

/* High contrast mode */
@media (prefers-contrast: high) {
    .toast {
        border-width: 2px;
        background: var(--bg-primary);
    }
    
    .toast-message {
        font-weight: 600;
    }
}

/* Reduced motion */
@media (prefers-reduced-motion: reduce) {
    .toast {
        animation: none;
        transform: translateX(0);
    }
    
    .toast-progress {
        animation: none;
    }
}

/* Progress Bar Animation Fix */
/* Progress Bar Animation - CRITICAL FIX */
#progress-bar {
    stroke: var(--accent-primary);
    stroke-linecap: round;
    transition: stroke-dashoffset 0.8s ease-in-out !important;
    filter: drop-shadow(0 0 10px var(--accent-glow));
}

.progress-circle {
    transform: rotate(-90deg);
    filter: drop-shadow(0 0 20px var(--accent-glow));
}

/* Force hardware acceleration */
.progress-ring {
    transform: translateZ(0);
    will-change: contents;
}



</style>